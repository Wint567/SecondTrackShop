{
  "name": "secondtrack-public-store",
  "version": "1.0.0",
  "description": "A server-rendered, editorial storefront for curated second-hand clothing, with Supabase inventory and Vinted checkout handoff.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wint567/SecondTrackShop.git"
  },
  "keywords": [
    "nextjs",
    "supabase",
    "react-three-fiber",
    "server-rendering",
    "second-hand-fashion"
  ],
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run bundle:check",
    "start": "next start",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --experimental-test-isolation=none tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "verify:prerender": "node scripts/verify-prerendered-html.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:prerender"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/env": "16.2.12",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
